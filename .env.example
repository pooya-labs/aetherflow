# Local-only development values. Replace all three passwords before starting.
POSTGRES_DB=aetherflow_dev
POSTGRES_USER=aetherflow_admin
POSTGRES_PASSWORD=local-only-admin-password-change-me
POSTGRES_PORT=5432
AETHERFLOW_MIGRATION_PASSWORD=local-only-migration-password-change-me
AETHERFLOW_RUNTIME_PASSWORD=local-only-runtime-password-change-me
# Authenticated API principals: burst capacity and continuous refill (requests/second).
# Defaults: 30 immediate requests, then 2 requests/second per operator or tenant principal.
AETHERFLOW_API_RATE_LIMIT_BURST=30
AETHERFLOW_API_RATE_LIMIT_PER_SECOND=2
