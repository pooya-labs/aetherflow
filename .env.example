# Local-only development values. Replace all three passwords before starting.
POSTGRES_DB=aetherflow_dev
POSTGRES_USER=aetherflow_admin
POSTGRES_PASSWORD=local-only-admin-password-change-me
POSTGRES_PORT=5432
AETHERFLOW_MIGRATION_PASSWORD=local-only-migration-password-change-me
AETHERFLOW_RUNTIME_PASSWORD=local-only-runtime-password-change-me
# Authenticated API principals: burst capacity and continuous refill (requests/second).
# Defaults: 30 immediate requests, then 2 requests/second per operator or tenant principal.
AETHERFLOW_API_RATE_LIMIT_BURST=30
AETHERFLOW_API_RATE_LIMIT_PER_SECOND=2
# Failed authentication attempts are tracked by the actual TCP peer address.
# Forwarded-IP headers are ignored; defaults: 20 failures, then 2 refills/second.
AETHERFLOW_AUTH_FAILURE_BURST=20
AETHERFLOW_AUTH_FAILURE_PER_SECOND=2
# Production NATS client settings are intentionally unset for local loopback Compose.
# A credentials file contains a JWT and private NKey seed; keep it in a secret manager.
# AETHERFLOW_NATS_CREDENTIALS_FILE=/run/secrets/aetherflow-nats.creds
# Set true explicitly for remote TLS deployments. It is inferred as true when
# credentials, custom CA roots, or an mTLS client identity are configured.
# AETHERFLOW_NATS_TLS_REQUIRED=true
# Optional private CA bundle and optional mutual-TLS client identity.
# AETHERFLOW_NATS_CA_FILE=/run/secrets/nats-ca.pem
# AETHERFLOW_NATS_CLIENT_CERT_FILE=/run/secrets/aetherflow-client.pem
# AETHERFLOW_NATS_CLIENT_KEY_FILE=/run/secrets/aetherflow-client-key.pem
